<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RgbFx.UI</RootNamespace>
    <ApplicationIcon />
    <Description>Minimal UI: select remote MSI Mystic Light targets for Dynamic Lighting bridge</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RgbFx.Service\RgbFx.Service.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="I18n\en.json" CopyToOutputDirectory="PreserveNewest" Link="I18n\en.json" />
    <None Include="I18n\zh-CN.json" CopyToOutputDirectory="PreserveNewest" Link="I18n\zh-CN.json" />
  </ItemGroup>
  <Target Name="PublishHalHost" AfterTargets="Publish" Condition="'$(PublishHalHost)' != 'false'">
    <MSBuild
      Projects="..\..\tools\AuraCapabilityDump\AuraCapabilityDump.csproj"
      Targets="Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x86;SelfContained=true;PublishDir=$(PublishDir)hal\" />
  </Target>
</Project>
